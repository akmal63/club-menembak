'use client'

import { useState, useMemo } from 'react'
import Image from 'next/image'
import { Search, User } from 'lucide-react'

export type PublicMember = {
  id: string
  member_number: string | null
  full_name: string | null
  position: string | null
  status: string | null
  photo_url: string | null
}

function isActive(status: string | null) {
  return (status ?? '').toLowerCase() === 'active'
}

export default function MembersTable({ members }: { members: PublicMember[] }) {
  const [q, setQ] = useState('')

  const filtered = useMemo(() => {
    const key = q.trim().toLowerCase()
    if (!key) return members
    return members.filter((m) =>
      [m.member_number, m.full_name, m.position]
        .filter(Boolean)
        .some((v) => (v as string).toLowerCase().includes(key))
    )
  }, [q, members])

  return (
    <div>
      {/* Kotak cari */}
      <div className="relative max-w-md mb-5">
        <Search className="w-4 h-4 text-[#8890b5] absolute left-3 top-1/2 -translate-y-1/2" />
        <input
          type="text"
          value={q}
          onChange={(e) => setQ(e.target.value)}
          placeholder="Cari data (nama / no. registrasi / jabatan)"
          className="w-full border rounded-lg pl-9 pr-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#ff5e3a]/40"
        />
      </div>

      {/* Tabel */}
      <div className="overflow-x-auto rounded-xl border border-[#e6e8f0] shadow-[0_4px_14px_rgba(10,14,39,0.06)]">
        <table className="w-full text-sm">
          <thead>
            <tr className="bg-[#0a0e27] text-white font-display uppercase tracking-wide text-xs">
              <th className="px-4 py-3 text-left w-24">Foto</th>
              <th className="px-4 py-3 text-left">Data</th>
            </tr>
          </thead>
          <tbody>
            {filtered.length === 0 ? (
              <tr>
                <td colSpan={2} className="px-4 py-10 text-center text-[#8890b5]">
                  Data tidak ditemukan.
                </td>
              </tr>
            ) : (
              filtered.map((m) => (
                <tr key={m.id} className="border-t border-[#eef0f6] hover:bg-[#f8f9fc]">
                  {/* Foto */}
                  <td className="px-4 py-3">
                    <div className="relative w-14 h-14 rounded-lg overflow-hidden bg-[#f0f2f8] grid place-items-center">
                      {m.photo_url ? (
                        <Image
                          src={m.photo_url}
                          alt={m.full_name ?? 'Anggota'}
                          fill
                          sizes="56px"
                          className="object-cover"
                        />
                      ) : (
                        <User className="w-6 h-6 text-[#c3c8dd]" />
                      )}
                    </div>
                  </td>

                  {/* Data */}
                  <td className="px-4 py-3">
                    <div className="text-xs text-[#8890b5]">
                      No. Reg: {m.member_number || '-'}
                    </div>
                    <div className="font-display font-bold uppercase tracking-wide text-[#0a0e27] leading-snug">
                      {m.full_name || '-'}
                    </div>
                    <div className="text-[#3a3f5c]">{m.position || '-'}</div>
                    <div>
                      <span
                        className={
                          'inline-block mt-1 px-2 py-0.5 rounded-full text-xs font-semibold ' +
                          (isActive(m.status)
                            ? 'bg-green-100 text-green-700'
                            : 'bg-gray-200 text-gray-600')
                        }
                      >
                        {isActive(m.status) ? 'Aktif' : 'Tidak Aktif'}
                      </span>
                    </div>

                    {/* Tombol Detail di bawah status */}
                    <a
                      href={`/anggota/${m.id}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      className="inline-block mt-2 px-4 py-1.5 rounded-lg text-xs font-display font-semibold uppercase tracking-wide text-white bg-[#1d4ed8] hover:bg-[#1e40af] transition-colors"
                    >
                      Detail
                    </a>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>

      <p className="text-xs text-[#8890b5] mt-3">
        Menampilkan {filtered.length} dari {members.length} anggota.
      </p>
    </div>
  )
}
