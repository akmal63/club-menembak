# Salin file ini menjadi .env.local lalu isi dengan kredensial Supabase Anda
# Ambil dari: Supabase Dashboard > Settings > API

# --- Kunci publik (aman dipakai di browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...ganti-dengan-anon-key-anda

# --- Kunci rahasia (HANYA server, JANGAN sebar) ---
# Dipakai untuk membuat/hapus akun oleh Super Admin.
# Ambil dari: Settings > API > service_role (atau secret key).
# JANGAN beri awalan NEXT_PUBLIC_ pada baris ini.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...ganti-dengan-service-role-key-anda
